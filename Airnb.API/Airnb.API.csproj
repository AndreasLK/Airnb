    <UserSecretsId>b61f2130-49aa-43e6-bf7c-4845f01446f0</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
