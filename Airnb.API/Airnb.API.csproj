      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.2.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Airnb.Application\Airnb.Application.csproj" />
    <ProjectReference Include="..\Airnb.Infrastructure\Airnb.Infrastructure.csproj" />
    <ProjectReference Include="..\Airnb.Shared\Airnb.Shared.csproj" />
  </ItemGroup>

</Project>
